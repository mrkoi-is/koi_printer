{
  "manifestVersion": 1,
  "id": "tms_sender_v1",
  "name": "寄件客户联 (TMS)",
  "version": 1,
  "category": "tms",
  "description": "标准物流寄件面单，含条码、二维码、运费明细、收发件人信息",
  "schema": [
    {
      "key": "companyName",
      "label": "公司名称"
    },
    {
      "key": "companyAdv",
      "label": "宣传语"
    },
    {
      "key": "fromNodeInfo",
      "label": "发件网点"
    },
    {
      "key": "toNodeInfo",
      "label": "目的网点"
    },
    {
      "key": "ticketSn",
      "label": "运单号"
    },
    {
      "key": "sequnceId",
      "label": "流水号"
    },
    {
      "key": "operatorName",
      "label": "操作员"
    },
    {
      "key": "startDate",
      "label": "开单时间"
    },
    {
      "key": "recieverName",
      "label": "收件人"
    },
    {
      "key": "recieverPhone",
      "label": "收件电话"
    },
    {
      "key": "pickMethod",
      "label": "取件方式"
    },
    {
      "key": "senderInfo",
      "label": "发件人"
    },
    {
      "key": "senderPhone",
      "label": "发件电话"
    },
    {
      "key": "weight",
      "label": "重量"
    },
    {
      "key": "volume",
      "label": "体积"
    },
    {
      "key": "cargoInfo",
      "label": "品名"
    },
    {
      "key": "cargoCount",
      "label": "件数"
    },
    {
      "key": "freightFee",
      "label": "应收运费"
    },
    {
      "key": "preFreightFee",
      "label": "现付运费"
    },
    {
      "key": "settlementMethod",
      "label": "结算方式"
    },
    {
      "key": "pickFee",
      "label": "接货费"
    },
    {
      "key": "psFee",
      "label": "派送费"
    },
    {
      "key": "totalFee",
      "label": "总运费"
    },
    {
      "key": "remark",
      "label": "备注"
    }
  ],
  "groups": [
    {
      "label": "标题区",
      "startIndex": 0,
      "endIndex": 3
    },
    {
      "label": "条码 & 单号",
      "startIndex": 4,
      "endIndex": 7
    },
    {
      "label": "收发件人信息",
      "startIndex": 8,
      "endIndex": 10
    },
    {
      "label": "费用明细",
      "startIndex": 11,
      "endIndex": 14
    },
    {
      "label": "底部",
      "startIndex": 15,
      "endIndex": 16
    }
  ],
  "mockData": {
    "companyName": "顺丰速运 (SF Express)",
    "companyAdv": "一站式供应链解决方案提供商",
    "fromNodeInfo": "深圳南山科技园网点",
    "toNodeInfo": "北京朝阳国贸网点",
    "ticketSn": "SF1234567890123",
    "sequnceId": "0001",
    "operatorName": "张三丰",
    "startDate": "2026-05-04 12:00:00",
    "recieverName": "李四",
    "pickMethod": "派送",
    "recieverPhone": "138****8000",
    "senderInfo": "王五",
    "senderPhone": "139****9000",
    "weight": "2.5",
    "volume": "0.01",
    "cargoInfo": "电子产品",
    "cargoCount": "1",
    "freightFee": "18.00",
    "preFreightFee": "18.00",
    "settlementMethod": "现付",
    "pickFee": "0.00",
    "psFee": "0.00",
    "totalFee": "18.00",
    "remark": "易碎物品，请轻拿轻放"
  },
  "document": {
    "documentType": "ticket",
    "paperSize": 80,
    "elements": [
      {
        "type": "text",
        "text": "{{companyName}}",
        "size": "size2",
        "align": "center",
        "bold": true
      },
      {
        "type": "text",
        "text": "{{companyAdv}}",
        "align": "center"
      },
      {
        "type": "text",
        "text": "发货: {{fromNodeInfo}}"
      },
      {
        "type": "text",
        "text": "收货: {{toNodeInfo}}"
      },
      {
        "type": "divider"
      },
      {
        "type": "barcode",
        "data": "{{ticketSn}}"
      },
      {
        "type": "textRow",
        "columns": [
          {
            "text": "运单号: {{ticketSn}}"
          },
          {
            "text": "流水号: {{sequnceId}}"
          }
        ]
      },
      {
        "type": "textRow",
        "columns": [
          {
            "text": "操作员: {{operatorName}}"
          },
          {
            "text": "{{startDate}}"
          }
        ]
      },
      {
        "type": "text",
        "text": "收货人: {{recieverName}} [{{pickMethod}}] {{recieverPhone}}",
        "bold": true
      },
      {
        "type": "text",
        "text": "发货人: {{senderInfo}} {{senderPhone}}"
      },
      {
        "type": "text",
        "text": "货物: {{weight}}吨 {{volume}}方 {{cargoInfo}} 合计:{{cargoCount}}"
      },
      {
        "type": "divider"
      },
      {
        "type": "textRow",
        "columns": [
          {
            "text": "应收运费: {{freightFee}}"
          },
          {
            "text": "现付运费: {{preFreightFee}}"
          },
          {
            "text": "结算: {{settlementMethod}}"
          }
        ]
      },
      {
        "type": "textRow",
        "columns": [
          {
            "text": "接货费: {{pickFee}}"
          },
          {
            "text": "派送费: {{psFee}}"
          }
        ]
      },
      {
        "type": "text",
        "text": "总计总额: {{totalFee}}",
        "size": "size2",
        "bold": true
      },
      {
        "type": "divider"
      },
      {
        "type": "text",
        "text": "备注: {{remark}}"
      },
      {
        "type": "qrCode",
        "data": "{{ticketSn}}"
      },
      {
        "type": "cut"
      }
    ]
  }
}