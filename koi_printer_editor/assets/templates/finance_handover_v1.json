{
  "manifestVersion": 1,
  "id": "finance_handover_v1",
  "name": "交款单 (Finance)",
  "version": 1,
  "category": "finance",
  "description": "财务交款单，含业务员交接明细列表 (ForEach)",
  "schema": [
    {
      "key": "nodeInfo",
      "label": "网点信息"
    },
    {
      "key": "bizerName",
      "label": "业务员"
    },
    {
      "key": "handUser",
      "label": "交款人"
    },
    {
      "key": "handDate",
      "label": "交款时间"
    },
    {
      "key": "totalAmount",
      "label": "总计金额"
    },
    {
      "key": "items",
      "label": "交接明细列表",
      "type": "array"
    }
  ],
  "groups": [
    {
      "label": "标题 & 信息",
      "startIndex": 0,
      "endIndex": 4
    },
    {
      "label": "明细列表",
      "startIndex": 5,
      "endIndex": 8
    },
    {
      "label": "合计",
      "startIndex": 9,
      "endIndex": 10
    }
  ],
  "mockData": {
    "nodeInfo": "深圳高新园财务中心",
    "bizerName": "李四",
    "handUser": "王五",
    "handDate": "2026-05-04 18:00",
    "totalAmount": "¥ 50,000",
    "items": [
      {
        "name": "顺丰特快",
        "count": 100,
        "amount": "¥1,800"
      },
      {
        "name": "顺丰标快",
        "count": 500,
        "amount": "¥6,000"
      },
      {
        "name": "包装费",
        "count": 100,
        "amount": "¥500"
      }
    ]
  },
  "document": {
    "documentType": "ticket",
    "paperSize": 80,
    "elements": [
      {
        "type": "text",
        "text": "交款单",
        "size": "size2",
        "align": "center",
        "bold": true
      },
      {
        "type": "text",
        "text": "网点: {{nodeInfo}}",
        "align": "center"
      },
      {
        "type": "divider"
      },
      {
        "type": "textRow",
        "columns": [
          {
            "text": "业务员: {{bizerName}}"
          },
          {
            "text": "交款人: {{handUser}}"
          }
        ]
      },
      {
        "type": "text",
        "text": "交款时间: {{handDate}}"
      },
      {
        "type": "divider"
      },
      {
        "type": "textRow",
        "columns": [
          {
            "text": "项目",
            "ratio": 6
          },
          {
            "text": "票数",
            "ratio": 2,
            "align": "center"
          },
          {
            "text": "金额",
            "ratio": 4,
            "align": "right"
          }
        ]
      },
      {
        "type": "divider"
      },
      {
        "type": "ticketForEach",
        "listKey": "items",
        "templates": [
          {
            "type": "textRow",
            "columns": [
              {
                "text": "{{name}}",
                "ratio": 6
              },
              {
                "text": "{{count}}",
                "ratio": 2,
                "align": "center"
              },
              {
                "text": "{{amount}}",
                "ratio": 4,
                "align": "right"
              }
            ]
          }
        ]
      },
      {
        "type": "divider"
      },
      {
        "type": "text",
        "text": "总计交款: {{totalAmount}}",
        "size": "size2",
        "bold": true
      },
      {
        "type": "cut"
      }
    ]
  }
}